# Web Server
PORT=3000
HOST=0.0.0.0

# JWT
JWT_SECRET=change-this-to-a-strong-random-secret-at-least-32-chars

# MCP Server
MCP_PORT=3001
MCP_SECRET=change-this-to-another-strong-secret
MCP_OUTPUT_LIMIT=12000
# Legacy query-token auth (?token=...) is disabled by default; enable only for
# stdio clients that cannot send an Authorization header.
RELAY_MCP_ALLOW_QUERY_TOKEN=false
# Public MCP protocol metadata version (also returned by /mcp/health).
RELAY_MCP_VERSION=0.6.3
# Graceful MCP process shutdown deadline before active HTTP connections are
# force-closed. Keep this comfortably below the platform termination deadline.
RELAY_MCP_SHUTDOWN_GRACE_MS=10000

# Database
DB_PATH=./data/app.db
KNOWLEDGE_DB_PATH=/workspace/.relay-mcp/knowledge.db
# Knowledge DB must never resolve to the same file as DB_PATH.
KNOWLEDGE_CAPTURE_INTERVAL_MS=1000
KNOWLEDGE_OUTBOX_PRUNE_INTERVAL_MS=3600000
KNOWLEDGE_OUTBOX_RETENTION_MS=2592000000
KNOWLEDGE_CONSUMER_HEARTBEAT_MS=604800000

# Workspace root (where user project directories are stored)
WORKSPACE_ROOT=/workspace
RELAY_STATE_ROOT=/workspace/.relay-mcp
RELAY_PUBLIC_URL=http://localhost:3000
RELAY_UPLOAD_TTL_MS=900000
RELAY_UPLOAD_MAX_BYTES=4294967296
RELAY_ARTIFACT_MAX_BYTES=4294967296
RELAY_DOWNLOAD_TTL_MS=900000

# Build fingerprint returned by /api/health
RELAY_VERSION=0.5.0
RELAY_BUILD_COMMIT=development
RELAY_BUILD_TIME=unknown

# SSH
SSH_KEYS_DIR=/workspace/.ssh-keys
