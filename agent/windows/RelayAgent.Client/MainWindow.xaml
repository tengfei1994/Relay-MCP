                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="390" MinWidth="320"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Style="{StaticResource SectionStyle}" Padding="12" Margin="0">
                                    <DataGrid x:Name="PlaywrightSuiteGrid" ItemsSource="{Binding PlaywrightSuites}" SelectionChanged="PlaywrightSuiteGrid_SelectionChanged">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Suite" Binding="{Binding Name}" Width="2*" MinWidth="160"/>
                                            <DataGridTextColumn Header="Web Client URL" Binding="{Binding BaseUrl}" Width="2.2*" MinWidth="220"/>
                                            <DataGridTextColumn Header="Test file" Binding="{Binding TestFile}" Width="1.6*" MinWidth="150"/>
                                            <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="86"/>
                                            <DataGridTemplateColumn Header="" Width="90">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource BaseButtonStyle}" MinWidth="68" Padding="8,4" Content="Run" Tag="{Binding Id}" Click="RunPlaywrightSuite_Click"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                                <Border x:Name="PlaywrightSuiteDetailsPanel" Grid.Column="2" Style="{StaticResource SectionStyle}" Margin="0">
