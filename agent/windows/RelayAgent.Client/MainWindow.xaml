                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="46"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="PlaywrightWebClientBox"
                                                          DisplayMemberPath="DisplayName"
                                                          SelectionChanged="PlaywrightWebClientBox_SelectionChanged">
                                                    <ComboBox.ItemContainerStyle>
                                                        <Style TargetType="ComboBoxItem">
                                                            <Setter Property="ToolTip" Value="{Binding Evidence}"/>
                                                        </Style>
                                                    </ComboBox.ItemContainerStyle>
                                                </ComboBox>
                                                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}"
                                                        ToolTip="Discover Web Client URLs from local IIS bindings"
                                                        Click="DiscoverPlaywrightWebClients_Click" Margin="8,0,0,0">
                                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" FontSize="16"/>
                                                </Button>
                                            </Grid>
                                            <TextBox x:Name="PlaywrightSuiteUrlBox" Margin="0,0,0,5"/>
                                            <TextBlock Text="Discovered from IIS bindings; the URL remains editable."
                                                       Foreground="{StaticResource MutedBrush}" FontSize="12" LineHeight="20" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                            <TextBlock Text="Test file" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6"/>
                                            <TextBox x:Name="PlaywrightSuiteFileBox" Margin="0,0,0,12"/>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Timeout seconds" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6"/>
                                                    <TextBox x:Name="PlaywrightSuiteTimeoutBox" Text="120" PreviewTextInput="NumericOnly_PreviewTextInput"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Retries" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6"/>
                                                    <TextBox x:Name="PlaywrightSuiteRetriesBox" Text="0" PreviewTextInput="NumericOnly_PreviewTextInput"/>
                                                </StackPanel>
                                            </Grid>
                                            <CheckBox x:Name="PlaywrightSuiteHeadlessCheck" Content="Headless browser" IsChecked="True" Margin="0,0,0,8"/>
                                            <CheckBox x:Name="PlaywrightSuiteEnabledCheck" Content="Suite enabled" IsChecked="True" Margin="0,0,0,16"/>
                                            <WrapPanel>
                                                <Button Style="{StaticResource PrimaryButtonStyle}" Click="SavePlaywrightSuite_Click">Save suite</Button>
                                                <Button Style="{StaticResource BaseButtonStyle}" Click="NewPlaywrightSuite_Click">New</Button>
                                                <Button Style="{StaticResource DangerButtonStyle}" Click="DeletePlaywrightSuite_Click">Delete</Button>
                                            </WrapPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Test runs">
                            <Grid Margin="0,16,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="0.55*"/>
                                </Grid.RowDefinitions>
                                <Border Style="{StaticResource SectionStyle}" Padding="12" Margin="0">
                                    <DataGrid x:Name="PlaywrightRunGrid" ItemsSource="{Binding PlaywrightRuns}" SelectionChanged="PlaywrightRunGrid_SelectionChanged">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Run ID" Binding="{Binding Id}" Width="1.4*" MinWidth="190"/>
                                            <DataGridTextColumn Header="Suite" Binding="{Binding SuiteName}" Width="1.7*" MinWidth="180"/>
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="98"/>
                                            <DataGridTextColumn Header="Started" Binding="{Binding StartedAt}" Width="170"/>
                                            <DataGridTextColumn Header="Duration" Binding="{Binding DurationMs}" Width="110"/>
                                            <DataGridTextColumn Header="Exit" Binding="{Binding ExitCode}" Width="70"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                                <GridSplitter Grid.Row="1" Height="10" HorizontalAlignment="Stretch" Background="Transparent"/>
                                <Border Grid.Row="2" Style="{StaticResource SectionStyle}" Padding="16" Margin="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Selected run" Style="{StaticResource SectionTitleStyle}"/>
                                        <controls:TerminalTextBox x:Name="PlaywrightRunDetailBox" Grid.Row="1" Text="Select a run to inspect details." MinHeight="180"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Artifacts">
                            <Grid Margin="0,16,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid x:Name="PlaywrightArtifactsHeaderGrid" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Failure screenshots, traces, logs, and test output." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    <WrapPanel x:Name="PlaywrightArtifactsActions" Grid.Column="1" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource BaseButtonStyle}" Click="OpenPlaywrightFolder_Click">Open folder</Button>
                                        <Button Style="{StaticResource DangerButtonStyle}" Click="ClearPlaywrightArtifacts_Click">Clear artifacts</Button>
                                    </WrapPanel>
                                </Grid>
                                <Border Grid.Row="1" Style="{StaticResource SectionStyle}" Padding="12" Margin="0">
                                    <DataGrid x:Name="PlaywrightArtifactGrid" ItemsSource="{Binding PlaywrightArtifacts}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="File" Binding="{Binding Name}" Width="2*" MinWidth="180"/>
                                            <DataGridTextColumn Header="Directory" Binding="{Binding DirectoryName}" Width="3*" MinWidth="300"/>
                                            <DataGridTextColumn Header="Size" Binding="{Binding Length}" Width="110"/>
                                            <DataGridTextColumn Header="Modified" Binding="{Binding LastWriteTime}" Width="170"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>

                <ScrollViewer x:Name="DiagnosticsPage"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="DiagnosticsPageGrid" MinHeight="590">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Diagnostics" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="Keep the Agent current and inspect local service logs."
                                   Style="{StaticResource PageSubtitleStyle}" Margin="0,0,0,18"/>
                    </StackPanel>
                    <Border Grid.Row="1" Style="{StaticResource SectionStyle}" Padding="18" Margin="0">
                        <Grid x:Name="DiagnosticsUpdateGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Client update" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="UpdateStatusText" Text="Current version v0.7.0" Foreground="{StaticResource MutedBrush}" LineHeight="22"/>
                            </StackPanel>
                            <WrapPanel x:Name="DiagnosticsUpdateActions" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource PrimaryButtonStyle}" Click="CheckUpdate_Click">Check update</Button>
                                <Button Style="{StaticResource BaseButtonStyle}" Click="OpenDataFolder_Click" ToolTip="Open Relay Agent data folder">Open data folder</Button>
                            </WrapPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="3" Style="{StaticResource SectionStyle}" Padding="16" Margin="0" MinHeight="310">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid x:Name="DiagnosticsLogToolbarGrid" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Agent log"
                                           Style="{StaticResource SectionTitleStyle}"
                                           Margin="0,0,24,8"
                                           VerticalAlignment="Center"/>
                                <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <WrapPanel x:Name="DiagnosticsLogFilters">
                                        <Button Style="{StaticResource BaseButtonStyle}" Click="RefreshLog_Click">Refresh</Button>
                                        <Button Style="{StaticResource BaseButtonStyle}" Click="OpenAgentLog_Click" ToolTip="Open the raw Agent log file">Open log file</Button>
                                        <CheckBox x:Name="LogAutoScrollCheck" Content="Auto-scroll" IsChecked="True" Margin="0,0,14,8"/>
                                        <TextBlock Text="Level" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,8"/>
                                        <ComboBox x:Name="LogLevelFilter" Width="108" SelectionChanged="LogLevelFilter_SelectionChanged" Margin="0,0,12,8">
                                            <ComboBoxItem Content="All"/>
                                            <ComboBoxItem Content="Error"/>
                                            <ComboBoxItem Content="Warning"/>
                                            <ComboBoxItem Content="Info"/>
                                        </ComboBox>
                                    </WrapPanel>
                                    <WrapPanel x:Name="DiagnosticsLogActions">
                                        <Button Style="{StaticResource DangerButtonStyle}" Click="ClearAgentLog_Click">Clear log</Button>
                                        <Button Style="{StaticResource BaseButtonStyle}" Click="CopySelectedLog_Click">Copy selected</Button>
                                    </WrapPanel>
                                </WrapPanel>
                            </Grid>
                            <controls:TerminalTextBox x:Name="AgentLogBox" Grid.Row="1" MinHeight="220"/>
                        </Grid>
                    </Border>
                </Grid>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,9">
                <TextBlock x:Name="FooterText" Foreground="{StaticResource MutedBrush}" FontSize="12" LineHeight="20"/>
            </Border>
        </Grid>
    </Grid>
</Window>
