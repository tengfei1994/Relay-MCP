<Window x:Class="RelayAgent.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Relay MCP Agent Client"
        Width="1280"
        Height="820"
        MinWidth="1080"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA"
        FontFamily="Segoe UI"
        FontSize="14"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="PrimarySoftBrush" Color="#EAF1FF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#172033"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#667085"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#DDE2EA"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#168554"/>
        <SolidColorBrush x:Key="SuccessSoftBrush" Color="#EAF8F0"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#B76A08"/>
        <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF5E4"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#C73535"/>
        <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDEEEE"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="22"/>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="12,2"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0,4,4,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EEF2F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="108"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F3F5F8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F2F3F5"/>
                                <Setter Property="Foreground" Value="#A0A6B0"/>
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#AFC7F6"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#AFC7F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            <Setter Property="BorderBrush" Value="#E8A6A6"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#C9D0DA"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#C9D0DA"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="ColumnHeaderHeight" Value="40"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PlaywrightTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="PlaywrightTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5,5,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#F1F4F8"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#FBFCFE" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="126"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="56"/>
                </Grid.RowDefinitions>

                <Grid Margin="28,28,20,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" Background="{StaticResource PrimaryBrush}" CornerRadius="3">
                        <TextBlock Text="R" Foreground="White" FontSize="22" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,2,0,0">
                        <TextBlock Text="Relay MCP" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Agent Client" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1">
                    <Button x:Name="OverviewNav" Tag="OverviewPage" Style="{StaticResource NavButtonStyle}" Click="Navigation_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" FontSize="16" Width="30"/>
                            <TextBlock Text="Overview"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ConnectionNav" Tag="ConnectionPage" Style="{StaticResource NavButtonStyle}" Click="Navigation_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE774;" FontSize="16" Width="30"/>
                            <TextBlock Text="Connection"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ServiceNav" Tag="ServicePage" Style="{StaticResource NavButtonStyle}" Click="Navigation_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="16" Width="30"/>
                            <TextBlock Text="Service Control"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="DatabaseNav" Tag="DatabasePage" Style="{StaticResource NavButtonStyle}" Click="Navigation_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="16" Width="30"/>
                            <TextBlock Text="Database Access"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="AuditNav" Tag="AuditPage" Style="{StaticResource NavButtonStyle}" Click="Navigation_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D5;" FontSize="16" Width="30"/>
                            <TextBlock Text="Request Audit"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="PlaywrightNav" Tag="PlaywrightPage" Style="{StaticResource NavButtonStyle}" Click="Navigation_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7C3;" FontSize="16" Width="30"/>
                            <TextBlock Text="Playwright"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="DiagnosticsNav" Tag="DiagnosticsPage" Style="{StaticResource NavButtonStyle}" Click="Navigation_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" FontSize="16" Width="30"/>
                            <TextBlock Text="Updates &amp; Logs"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="v0.6" Foreground="{StaticResource MutedBrush}" FontSize="12"
                           Margin="28,0,0,18" VerticalAlignment="Bottom"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="82"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="36"/>
            </Grid.RowDefinitions>

            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="30,0,22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="145"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="145"/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Agent operations" FontSize="19" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="CONNECTION" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="HeaderConnectionText" Text="Not configured" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="SERVICE" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="HeaderServiceText" Text="Not installed" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <TextBlock Text="VERSION" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="v0.6" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                        <TextBlock Text="LAST SEEN" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="HeaderLastSeenText" Text="No heartbeat" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="5" Style="{StaticResource IconButtonStyle}" ToolTip="Refresh status" Click="RefreshAll_Click">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" FontSize="17"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" x:Name="PageHost" Margin="30,22,22,20">
                <!-- Overview -->
                <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Overview" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Connection, service, database, and audit readiness at a glance."
                                   Foreground="{StaticResource MutedBrush}" Margin="0,5,0,22"/>

                        <Border Style="{StaticResource CardStyle}" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Margin="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource PrimarySoftBrush}">
                                        <TextBlock Text="1" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Connect Relay" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="OverviewConnectionText" Text="Action required" Foreground="{StaticResource WarningBrush}" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Column="1" Margin="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource PrimarySoftBrush}">
                                        <TextBlock Text="2" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Install Service" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="OverviewServiceText" Text="Not installed" Foreground="{StaticResource WarningBrush}" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Column="2" Margin="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource PrimarySoftBrush}">
                                        <TextBlock Text="3" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Database Access" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="OverviewDatabaseText" Text="Not checked" Foreground="{StaticResource WarningBrush}" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Column="3" Margin="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource PrimarySoftBrush}">
                                        <TextBlock Text="4" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Verify Agent" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="OverviewAuditText" Text="Audit enabled" Foreground="{StaticResource SuccessBrush}" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="320"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,16,0" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="Agent summary" Style="{StaticResource SectionTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="38"/>
                                            <RowDefinition Height="38"/><RowDefinition Height="38"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Relay endpoint" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBlock x:Name="SummaryRelayText" Grid.Column="1" VerticalAlignment="Center"/>
                                        <TextBlock Text="Agent ID" Grid.Row="1" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBlock x:Name="SummaryAgentIdText" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"/>
                                        <TextBlock Text="Service account" Grid.Row="2" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBlock x:Name="SummaryServiceAccountText" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"/>
                                        <TextBlock Text="Polling interval" Grid.Row="3" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBlock x:Name="SummaryPollText" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center"/>
                                        <TextBlock Text="Audit retention" Grid.Row="4" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBlock x:Name="SummaryAuditText" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="Quick actions" Style="{StaticResource SectionTitleStyle}"/>
                                    <Button Style="{StaticResource BaseButtonStyle}" Margin="0,0,0,10" Click="TestRelay_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8FA;" Margin="0,0,9,0"/>
                                            <TextBlock Text="Test relay"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource BaseButtonStyle}" Margin="0,0,0,10" Click="RestartService_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" Margin="0,0,9,0"/>
                                            <TextBlock Text="Restart service"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource BaseButtonStyle}" Margin="0,0,0,10" Click="OpenDatabasePage_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" Margin="0,0,9,0"/>
                                            <TextBlock Text="Check database access"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource BaseButtonStyle}" Click="OpenAuditPage_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D5;" Margin="0,0,9,0"/>
                                            <TextBlock Text="Open request audit"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Connection -->
                <ScrollViewer x:Name="ConnectionPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Secure connection" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Relay credentials are encrypted locally and never shown in plaintext after save."
                                   Foreground="{StaticResource MutedBrush}" Margin="0,5,0,22"/>
                        <Border Style="{StaticResource CardStyle}" MaxWidth="900" HorizontalAlignment="Left">
                            <StackPanel>
                                <TextBlock Text="Connection configuration" Style="{StaticResource SectionTitleStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="54"/><RowDefinition Height="54"/><RowDefinition Height="54"/>
                                        <RowDefinition Height="54"/><RowDefinition Height="48"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Relay MCP address" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="RelayUrlBox" Grid.Column="1" VerticalAlignment="Center"/>
                                    <Button Grid.Column="2" Style="{StaticResource BaseButtonStyle}" Margin="8,7,0,7" Click="ReplaceRelayUrl_Click">Replace</Button>
                                    <TextBlock Text="Agent ID" Grid.Row="1" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="AgentIdBox" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"/>
                                    <TextBlock Text="Agent token" Grid.Row="2" Style="{StaticResource FieldLabelStyle}"/>
                                    <PasswordBox x:Name="AgentTokenBox" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"/>
                                    <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource BaseButtonStyle}" Margin="8,7,0,7" Click="ReplaceToken_Click">Replace token</Button>
                                    <TextBlock Text="Poll interval" Grid.Row="3" Style="{StaticResource FieldLabelStyle}"/>
                                    <Grid Grid.Row="3" Grid.Column="1" Width="160" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                                        <TextBox x:Name="PollSecondsBox" Text="10" PreviewTextInput="NumericOnly_PreviewTextInput"/>
                                        <TextBlock Grid.Column="1" Text="seconds" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </Grid>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                                               Text="Protected with Windows DPAPI (LocalMachine) and restricted file permissions."
                                               Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="160,18,0,0">
                                    <Button Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0" Click="SaveConfiguration_Click">Save securely</Button>
                                    <Button Style="{StaticResource BaseButtonStyle}" Click="TestRelay_Click">Test relay</Button>
                                </StackPanel>
                                <Border x:Name="ConnectionNoticeBorder" Margin="160,18,0,0" Padding="12,9" Background="#F3F5F8" CornerRadius="4">
                                    <TextBlock x:Name="ConnectionNoticeText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Service -->
                <ScrollViewer x:Name="ServicePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Service control" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Install, update, start, and inspect the Windows Service that runs the Agent."
                                   Foreground="{StaticResource MutedBrush}" Margin="0,5,0,22"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="390"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,16,0">
                                <StackPanel>
                                    <TextBlock Text="Windows Service" Style="{StaticResource SectionTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="48"/><RowDefinition Height="48"/>
                                            <RowDefinition Height="66"/><RowDefinition Height="48"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Status" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBlock x:Name="ServiceStateText" Grid.Column="1" VerticalAlignment="Center"/>
                                        <TextBlock Text="Running as" Grid.Row="1" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBlock x:Name="ServiceIdentityText" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"/>
                                        <TextBlock Text="Executable" Grid.Row="2" Style="{StaticResource FieldLabelStyle}"/>
                                        <Grid Grid.Row="2" Grid.Column="1">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="ServicePathText" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" ToolTip="Copy executable path" Click="CopyServicePath_Click">
                                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C8;"/>
                                            </Button>
                                        </Grid>
                                        <TextBlock Text="Startup" Grid.Row="3" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Automatic" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Service actions" Style="{StaticResource SectionTitleStyle}"/>
                                    <Button Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,14" Click="InstallService_Click">Install or update service</Button>
                                    <UniformGrid Columns="3" Margin="0,0,0,18">
                                        <Button x:Name="StartServiceButton" Style="{StaticResource BaseButtonStyle}" Margin="0,0,6,0" Click="StartService_Click">Start</Button>
                                        <Button x:Name="StopServiceButton" Style="{StaticResource BaseButtonStyle}" Margin="3,0" Click="StopService_Click">Stop</Button>
                                        <Button x:Name="RestartServiceButton" Style="{StaticResource BaseButtonStyle}" Margin="6,0,0,0" Click="RestartService_Click">Restart</Button>
                                    </UniformGrid>
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,18"/>
                                    <Button x:Name="UninstallServiceButton" Style="{StaticResource DangerButtonStyle}" Click="UninstallService_Click">Uninstall service</Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Database -->
                <ScrollViewer x:Name="DatabasePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Database access" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Detect SampleManager databases and grant the Agent service identity only the permissions it needs."
                                   Foreground="{StaticResource MutedBrush}" Margin="0,5,0,22"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="390"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,16,16" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="Target" Style="{StaticResource SectionTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="50"/><RowDefinition Height="50"/>
                                            <RowDefinition Height="50"/><RowDefinition Height="50"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="SQL Server" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox x:Name="SqlServerBox" Grid.Column="1" IsEditable="True"/>
                                        <TextBlock Text="Database" Grid.Row="1" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox x:Name="DatabaseBox" Grid.Row="1" Grid.Column="1"/>
                                        <TextBlock Text="Service identity" Grid.Row="2" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBlock x:Name="DatabaseIdentityText" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"/>
                                        <TextBlock Text="Current result" Grid.Row="3" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBlock x:Name="DatabaseResultText" Grid.Row="3" Grid.Column="1" Text="Not checked" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="Discovery &amp; verification" Style="{StaticResource SectionTitleStyle}"/>
                                    <Button Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,10" Click="DetectDatabases_Click">Detect databases</Button>
                                    <Button Style="{StaticResource BaseButtonStyle}" Click="TestDatabaseAccess_Click">Test current access</Button>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,16,0">
                                <StackPanel>
                                    <TextBlock Text="Permission evidence" Style="{StaticResource SectionTitleStyle}"/>
                                    <DataGrid x:Name="PermissionGrid" Height="280" ItemsSource="{Binding PermissionRows}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Permission" Binding="{Binding Permission}" Width="1.4*"/>
                                            <DataGridTemplateColumn Header="Current" Width="1.1*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding StatusBackground}" CornerRadius="3" Padding="7,3" HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding Current}" Foreground="{Binding StatusForeground}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Read" Binding="{Binding Read}" Width="*"/>
                                            <DataGridTextColumn Header="Write" Binding="{Binding Write}" Width="*"/>
                                            <DataGridTextColumn Header="DDL" Binding="{Binding Ddl}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Access actions" Style="{StaticResource SectionTitleStyle}"/>
                                    <Button Style="{StaticResource BaseButtonStyle}" Margin="0,0,0,10" Click="GrantRead_Click">Grant read access</Button>
                                    <Button Style="{StaticResource BaseButtonStyle}" Margin="0,0,0,18" Click="GrantReadWrite_Click">Grant read/write access</Button>
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,18"/>
                                    <Button Style="{StaticResource DangerButtonStyle}" Margin="0,0,0,10" Click="GrantDdl_Click">Grant DDL access</Button>
                                    <Button Style="{StaticResource DangerButtonStyle}" Click="RevokeDatabaseAccess_Click">Revoke database access</Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Audit -->
                <Grid x:Name="AuditPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="156"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Request audit" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Every audited Relay GET and POST request. Credentials are always redacted."
                                   Foreground="{StaticResource MutedBrush}" Margin="0,5,0,18"/>
                    </StackPanel>
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="AuditEnabledCheck" Content="Audit enabled" Margin="0,0,18,0"/>
                                <CheckBox x:Name="AuditPayloadsCheck" Content="Log redacted payloads" Margin="0,0,18,0"/>
                                <TextBlock Text="Retention" Style="{StaticResource FieldLabelStyle}" Margin="0,0,7,0"/>
                                <TextBox x:Name="AuditRetentionBox" Width="58" Text="14" PreviewTextInput="NumericOnly_PreviewTextInput" Margin="0,0,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Method" Style="{StaticResource FieldLabelStyle}" Margin="18,0,7,0"/>
                                <ComboBox x:Name="AuditMethodFilter" Width="88" Margin="0,0,12,0" SelectionChanged="AuditFilter_SelectionChanged">
                                    <ComboBoxItem Content="All"/><ComboBoxItem Content="GET"/><ComboBoxItem Content="POST"/>
                                </ComboBox>
                                <TextBlock Text="Status" Style="{StaticResource FieldLabelStyle}" Margin="0,0,7,0"/>
                                <ComboBox x:Name="AuditStatusFilter" Width="98" Margin="0,0,12,0" SelectionChanged="AuditFilter_SelectionChanged">
                                    <ComboBoxItem Content="All"/><ComboBoxItem Content="Success"/><ComboBoxItem Content="Failed"/>
                                </ComboBox>
                                <Button Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Click="ApplyAuditSettings_Click">Apply</Button>
                                <Button Style="{StaticResource BaseButtonStyle}" Margin="0,0,8,0" Click="ExportAudit_Click">Export</Button>
                                <Button Style="{StaticResource DangerButtonStyle}" Click="ClearAudit_Click">Clear</Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,0,14">
                        <Grid>
                            <DataGrid x:Name="AuditGrid" ItemsSource="{Binding AuditRows}" SelectionChanged="AuditGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="155"/>
                                    <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="75"/>
                                    <DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint}" Width="3*"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                                    <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="95"/>
                                    <DataGridTextColumn Header="Job ID" Binding="{Binding JobId}" Width="1.5*"/>
                                    <DataGridTextColumn Header="Payload" Binding="{Binding Payload}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="AuditEmptyText" Text="No audited requests yet." Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="Selected request" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <TextBox x:Name="AuditDetailBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                                     VerticalAlignment="Stretch" Background="#FBFCFE"
                                     Text="Select a request to inspect details."/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Playwright -->
                <Grid x:Name="PlaywrightPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Playwright" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="Install the browser runtime and manage SampleManager Web Client tests."
                                       Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Style="{StaticResource BaseButtonStyle}" Margin="0,0,10,0" Click="RefreshPlaywright_Click">Check runtime</Button>
                            <Button x:Name="PlaywrightInstallButton" Style="{StaticResource PrimaryButtonStyle}" Click="QueuePlaywrightInstall_Click">Install dependencies</Button>
                        </StackPanel>
                    </Grid>

                    <TabControl Grid.Row="1" x:Name="PlaywrightTabs"
                                Style="{StaticResource PlaywrightTabControlStyle}"
                                ItemContainerStyle="{StaticResource PlaywrightTabItemStyle}">
                        <TabItem Header="Overview">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="16">
                                    <UniformGrid Columns="3" Margin="0,0,0,16">
                                        <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0" Padding="18">
                                            <StackPanel>
                                                <TextBlock Text="Runtime" Foreground="{StaticResource MutedBrush}"/>
                                                <TextBlock x:Name="PlaywrightOverviewRuntimeText" Text="Not checked" FontSize="18" FontWeight="SemiBold" Margin="0,9,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource CardStyle}" Margin="5,0" Padding="18">
                                            <StackPanel>
                                                <TextBlock Text="Last run" Foreground="{StaticResource MutedBrush}"/>
                                                <TextBlock x:Name="PlaywrightOverviewLastRunText" Text="No runs yet" FontSize="18" FontWeight="SemiBold" Margin="0,9,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource CardStyle}" Margin="10,0,0,0" Padding="18">
                                            <StackPanel>
                                                <TextBlock Text="Artifacts" Foreground="{StaticResource MutedBrush}"/>
                                                <TextBlock x:Name="PlaywrightOverviewArtifactsText" Text="0 files" FontSize="18" FontWeight="SemiBold" Margin="0,9,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Runtime summary" Style="{StaticResource SectionTitleStyle}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="44"/><RowDefinition Height="44"/><RowDefinition Height="44"/><RowDefinition Height="44"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Node.js" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBlock x:Name="PlaywrightOverviewNodeText" Grid.Column="1" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="PlaywrightOverviewNodeStatusText" Grid.Column="2" VerticalAlignment="Center"/>
                                                <TextBlock Text="Playwright" Grid.Row="1" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBlock x:Name="PlaywrightOverviewPackageText" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="PlaywrightOverviewPackageStatusText" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"/>
                                                <TextBlock Text="Chromium" Grid.Row="2" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBlock x:Name="PlaywrightOverviewBrowserText" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="PlaywrightOverviewBrowserStatusText" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center"/>
                                                <TextBlock Text="Service account" Grid.Row="3" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="NT AUTHORITY\SYSTEM" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="3" Grid.Column="2" Text="Background execution" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Runtime">
                            <Grid Margin="16">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Dependencies" Style="{StaticResource SectionTitleStyle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="52"/><RowDefinition Height="52"/><RowDefinition Height="52"/><RowDefinition Height="52"/><RowDefinition Height="52"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Node.js" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock x:Name="PlaywrightNodeText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="PlaywrightNodeStatusText" Grid.Column="2" VerticalAlignment="Center"/>
                                            <TextBlock Text="npm" Grid.Row="1" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock x:Name="PlaywrightNpmText" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="PlaywrightNpmStatusText" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"/>
                                            <TextBlock Text="Playwright package" Grid.Row="2" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock x:Name="PlaywrightPackageText" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="PlaywrightPackageStatusText" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center"/>
                                            <TextBlock Text="Chromium" Grid.Row="3" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock x:Name="PlaywrightChromiumText" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="PlaywrightChromiumStatusText" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center"/>
                                            <TextBlock Text="Browser cache" Grid.Row="4" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock x:Name="PlaywrightCacheText" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,22,0">
                                            <TextBlock Text="Installation" Style="{StaticResource SectionTitleStyle}"/>
                                            <TextBlock x:Name="PlaywrightInstallMessageText" Text="Runtime has not been checked." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,18"/>
                                            <ProgressBar x:Name="PlaywrightInstallProgress" Height="9" Minimum="0" Maximum="100"/>
                                            <DockPanel Margin="0,8,0,18">
                                                <TextBlock x:Name="PlaywrightInstallTaskText" Foreground="{StaticResource MutedBrush}"/>
                                                <TextBlock x:Name="PlaywrightInstallProgressText" HorizontalAlignment="Right"/>
                                            </DockPanel>
                                            <TextBlock Text="Installation flow" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                                       Text="If Node.js is missing, the Agent downloads and silently installs the latest Windows x64 LTS MSI. It then installs @playwright/test, Chromium, and verifies the service-owned browser cache."/>
                                        </StackPanel>
                                        <Grid Grid.Column="1">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <TextBlock Text="Installation log" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                            <TextBox Grid.Row="1" x:Name="PlaywrightRuntimeLogBox" IsReadOnly="True" AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                 TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                                                 MinHeight="280" Background="#FBFCFE"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Test suites">
                            <Grid Margin="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="410"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,14,0" Padding="12">
                                    <DataGrid x:Name="PlaywrightSuiteGrid" ItemsSource="{Binding PlaywrightSuites}" SelectionChanged="PlaywrightSuiteGrid_SelectionChanged">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Suite" Binding="{Binding Name}" Width="2*"/>
                                            <DataGridTextColumn Header="Web Client URL" Binding="{Binding BaseUrl}" Width="2*"/>
                                            <DataGridTextColumn Header="Test file" Binding="{Binding TestFile}" Width="1.5*"/>
                                            <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="75"/>
                                            <DataGridTemplateColumn Header="" Width="80">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource BaseButtonStyle}" MinWidth="62" Height="30" Padding="8,0" Content="Run" Tag="{Binding Id}" Click="RunPlaywrightSuite_Click"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Suite details" Style="{StaticResource SectionTitleStyle}"/>
                                        <TextBlock Text="Name" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,5"/>
                                        <TextBox x:Name="PlaywrightSuiteNameBox" Margin="0,0,0,12"/>
                                        <TextBlock Text="Web Client URL" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,5"/>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                                            <ComboBox x:Name="PlaywrightWebClientBox"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectionChanged="PlaywrightWebClientBox_SelectionChanged">
                                                <ComboBox.ItemContainerStyle>
                                                    <Style TargetType="ComboBoxItem">
                                                        <Setter Property="ToolTip" Value="{Binding Evidence}"/>
                                                    </Style>
                                                </ComboBox.ItemContainerStyle>
                                            </ComboBox>
                                            <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}"
                                                    ToolTip="Discover Web Client URLs from local IIS bindings"
                                                    Click="DiscoverPlaywrightWebClients_Click">
                                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" FontSize="16"/>
                                            </Button>
                                        </Grid>
                                        <TextBox x:Name="PlaywrightSuiteUrlBox" Margin="0,0,0,4"/>
                                        <TextBlock Text="Discovered from IIS site bindings; the URL remains editable."
                                                   Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,12"/>
                                        <TextBlock Text="Test file" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,5"/>
                                        <TextBox x:Name="PlaywrightSuiteFileBox" Margin="0,0,0,12"/>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,6,0">
                                                <TextBlock Text="Timeout seconds" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,5"/>
                                                <TextBox x:Name="PlaywrightSuiteTimeoutBox" Text="120" PreviewTextInput="NumericOnly_PreviewTextInput"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock Text="Retries" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,5"/>
                                                <TextBox x:Name="PlaywrightSuiteRetriesBox" Text="0" PreviewTextInput="NumericOnly_PreviewTextInput"/>
                                            </StackPanel>
                                        </Grid>
                                        <CheckBox x:Name="PlaywrightSuiteHeadlessCheck" Content="Headless browser" IsChecked="True" Margin="0,0,0,10"/>
                                        <CheckBox x:Name="PlaywrightSuiteEnabledCheck" Content="Suite enabled" IsChecked="True" Margin="0,0,0,18"/>
                                        <Button Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,10" Click="SavePlaywrightSuite_Click">Save suite</Button>
                                        <UniformGrid Columns="2">
                                            <Button Style="{StaticResource BaseButtonStyle}" Margin="0,0,5,0" Click="NewPlaywrightSuite_Click">New</Button>
                                            <Button Style="{StaticResource DangerButtonStyle}" Margin="5,0,0,0" Click="DeletePlaywrightSuite_Click">Delete</Button>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Test runs">
                            <Grid Margin="16">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="210"/></Grid.RowDefinitions>
                                <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,14">
                                    <DataGrid x:Name="PlaywrightRunGrid" ItemsSource="{Binding PlaywrightRuns}" SelectionChanged="PlaywrightRunGrid_SelectionChanged">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Run ID" Binding="{Binding Id}" Width="1.4*"/>
                                            <DataGridTextColumn Header="Suite" Binding="{Binding SuiteName}" Width="1.7*"/>
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                                            <DataGridTextColumn Header="Started" Binding="{Binding StartedAt}" Width="160"/>
                                            <DataGridTextColumn Header="Duration" Binding="{Binding DurationMs}" Width="100"/>
                                            <DataGridTextColumn Header="Exit" Binding="{Binding ExitCode}" Width="70"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <TextBlock Text="Selected run" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                        <TextBox x:Name="PlaywrightRunDetailBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                 TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                                                 Text="Select a run to inspect details." Background="#FBFCFE"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Artifacts">
                            <Grid Margin="16">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Text="Failure screenshots, traces, logs, and test output." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource BaseButtonStyle}" Margin="0,0,10,0" Click="OpenPlaywrightFolder_Click">Open folder</Button>
                                        <Button Style="{StaticResource DangerButtonStyle}" Click="ClearPlaywrightArtifacts_Click">Clear artifacts</Button>
                                    </StackPanel>
                                </DockPanel>
                                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12">
                                    <DataGrid x:Name="PlaywrightArtifactGrid" ItemsSource="{Binding PlaywrightArtifacts}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="File" Binding="{Binding Name}" Width="2*"/>
                                            <DataGridTextColumn Header="Directory" Binding="{Binding DirectoryName}" Width="3*"/>
                                            <DataGridTextColumn Header="Size" Binding="{Binding Length}" Width="100"/>
                                            <DataGridTextColumn Header="Modified" Binding="{Binding LastWriteTime}" Width="160"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>

                <!-- Diagnostics -->
                <Grid x:Name="DiagnosticsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Updates &amp; logs" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Keep the Agent current and inspect local service diagnostics."
                                   Foreground="{StaticResource MutedBrush}" Margin="0,5,0,18"/>
                    </StackPanel>
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Client update" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock x:Name="UpdateStatusText" Text="Current version v0.5.3" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0" Click="CheckUpdate_Click">Check update</Button>
                                <Button Style="{StaticResource BaseButtonStyle}" Click="OpenDataFolder_Click">Open data folder</Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="50"/></Grid.RowDefinitions>
                            <TextBlock Text="Agent log" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <TextBox x:Name="AgentLogBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                                     VerticalAlignment="Stretch" MinHeight="220" Background="#FBFCFE"/>
                            <DockPanel Grid.Row="2" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <Button Style="{StaticResource BaseButtonStyle}" Margin="0,0,8,0" Click="RefreshLog_Click">Refresh</Button>
                                    <Button Style="{StaticResource BaseButtonStyle}" Margin="0,0,14,0" Click="OpenAgentLog_Click">Open log file</Button>
                                    <CheckBox x:Name="LogAutoScrollCheck" Content="Auto-scroll" IsChecked="True" Margin="0,0,14,0"/>
                                    <TextBlock Text="Level" Style="{StaticResource FieldLabelStyle}" Margin="0,0,7,0"/>
                                    <ComboBox x:Name="LogLevelFilter" Width="96" SelectionChanged="LogLevelFilter_SelectionChanged">
                                        <ComboBoxItem Content="All"/><ComboBoxItem Content="Error"/><ComboBoxItem Content="Warning"/><ComboBoxItem Content="Info"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource DangerButtonStyle}" Margin="0,0,8,0" Click="ClearAgentLog_Click">Clear log</Button>
                                    <Button Style="{StaticResource BaseButtonStyle}" Click="CopySelectedLog_Click">Copy selected</Button>
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <TextBlock x:Name="FooterText" Foreground="{StaticResource MutedBrush}" FontSize="12"
                           Margin="30,0,22,0" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Grid>
</Window>
