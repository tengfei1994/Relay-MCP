                                            <TextBlock Text="Installation" Style="{StaticResource SectionTitleStyle}"/>
                                            <TextBlock x:Name="PlaywrightInstallMessageText" Text="Runtime has not been checked." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,16"/>
                                            <ProgressBar x:Name="PlaywrightInstallProgress" Height="10" Minimum="0" Maximum="100"/>
                                            <Grid Margin="0,8,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="PlaywrightInstallTaskText" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="PlaywrightInstallProgressText" Grid.Column="1" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <TextBlock Text="Flow" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" LineHeight="24"/>
                                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" LineHeight="22"
                                                       Text="If Node.js is missing, the Agent downloads and silently installs Windows x64 LTS. It then installs @playwright/test, Chromium, and verifies the service-owned browser cache."/>
                                        </StackPanel>
                                    </Border>
                                    <GridSplitter x:Name="PlaywrightRuntimeSplitter" Grid.Column="1"
                                                  Width="12"
                                                  HorizontalAlignment="Stretch"
                                                  Background="Transparent"/>
                                    <Border x:Name="PlaywrightRuntimeLogPanel" Grid.Column="2" Style="{StaticResource SectionStyle}" Margin="0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Installation log" Style="{StaticResource SectionTitleStyle}"/>
                                            <controls:TerminalTextBox Grid.Row="1" x:Name="PlaywrightRuntimeLogBox" MinHeight="260"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Test suites">
                            <ScrollViewer x:Name="PlaywrightSuitesScroller"
                                          VerticalScrollBarVisibility="Disabled"
                                          HorizontalScrollBarVisibility="Disabled">
                            <Grid x:Name="PlaywrightSuitesLayoutGrid" Margin="0,16,0,0">
