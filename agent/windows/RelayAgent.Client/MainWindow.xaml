<Window x:Class="RelayAgent.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RelayAgent.Client.Controls"
        Title="Relay MCP Agent Client"
        Width="1240"
        Height="820"
        MinWidth="900"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI"
        FontSize="14"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F6FA"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="PrimarySoftBrush" Color="#EAF1FF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#172033"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#667085"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#DDE3EC"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#168554"/>
        <SolidColorBrush x:Key="SuccessSoftBrush" Color="#EAF8F0"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#B76A08"/>
        <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF5E4"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#C73535"/>
        <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDEEEE"/>
        <SolidColorBrush x:Key="TerminalBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="TerminalBorderBrush" Color="#334155"/>

        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="27"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="LineHeight" Value="36"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="LineHeight" Value="24"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="LineHeight" Value="26"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="LineHeight" Value="24"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <Style x:Key="ValueTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="LineHeight" Value="24"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="LineHeight" Value="20"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
            <Setter Property="MinWidth" Value="200"/>
            <Setter Property="MinHeight" Value="112"/>
        </Style>

        <Style x:Key="SectionStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0,6,6,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EEF2F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F3F6FA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F2F4F7"/>
                                <Setter Property="Foreground" Value="#98A2B3"/>
                                <Setter Property="Opacity" Value="0.76"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#AFC7F6"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#AFC7F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            <Setter Property="BorderBrush" Value="#E8A6A6"/>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="MinWidth" Value="38"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#C9D2DD"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#C9D2DD"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="0,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="ColumnHeaderHeight" Value="42"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
        </Style>

        <Style x:Key="PlaywrightTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="PlaywrightTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="208" MinWidth="72"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <StackPanel x:Name="SidebarBrandPanel" DockPanel.Dock="Top" Margin="22,24,18,22">
                    <TextBlock x:Name="SidebarTitleText" Text="Relay MCP" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" LineHeight="30"/>
                    <TextBlock x:Name="SidebarSubtitleText" Text="Agent Client" Foreground="{StaticResource MutedBrush}" LineHeight="22"/>
                </StackPanel>

                <Border x:Name="SidebarInfoPanel" DockPanel.Dock="Bottom" Margin="16,16,16,20" Padding="12" Background="{StaticResource SurfaceAltBrush}" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Service-owned execution" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" LineHeight="23"/>
                        <TextBlock Text="Config and tokens are protected with DPAPI LocalMachine."
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   LineHeight="21"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Button x:Name="OverviewNav" Tag="OverviewPage" Style="{StaticResource NavButtonStyle}" Click="Navigation_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" Width="26"/>
                            <TextBlock Text="Overview"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ConnectionNav" Tag="ConnectionPage" Style="{StaticResource NavButtonStyle}" Click="Navigation_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE774;" Width="26"/>
                            <TextBlock Text="Connection"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ServiceNav" Tag="ServicePage" Style="{StaticResource NavButtonStyle}" Click="Navigation_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7EF;" Width="26"/>
                            <TextBlock Text="Service"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="DatabaseNav" Tag="DatabasePage" Style="{StaticResource NavButtonStyle}" Click="Navigation_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8E5;" Width="26"/>
                            <TextBlock Text="Database"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="AuditNav" Tag="AuditPage" Style="{StaticResource NavButtonStyle}" Click="Navigation_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D5;" Width="26"/>
                            <TextBlock Text="Request Audit"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="PlaywrightNav" Tag="PlaywrightPage" Style="{StaticResource NavButtonStyle}" Click="Navigation_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7C3;" Width="26"/>
                            <TextBlock Text="Playwright"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="DiagnosticsNav" Tag="DiagnosticsPage" Style="{StaticResource NavButtonStyle}" Click="Navigation_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" Width="26"/>
                            <TextBlock Text="Diagnostics"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="26,18,22,18">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Agent operations" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" LineHeight="32"/>
                            <TextBlock Text="Configure, operate, audit, and test the Relay Agent from one local console."
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       LineHeight="22"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" ToolTip="Refresh status" Click="RefreshAll_Click" Margin="16,4,0,4">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" FontSize="15"/>
                        </Button>
                    </Grid>
                    <WrapPanel Margin="0,14,0,0">
                        <Border Margin="0,0,10,10" Padding="12,8" Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" MinWidth="122">
                            <StackPanel>
                                <TextBlock Text="Connection" Foreground="{StaticResource MutedBrush}" FontSize="12" LineHeight="18"/>
                                <TextBlock x:Name="HeaderConnectionText" Text="Not configured" Style="{StaticResource StatusTextStyle}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,10,10" Padding="12,8" Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" MinWidth="116">
                            <StackPanel>
                                <TextBlock Text="Service" Foreground="{StaticResource MutedBrush}" FontSize="12" LineHeight="18"/>
                                <TextBlock x:Name="HeaderServiceText" Text="Not installed" Style="{StaticResource StatusTextStyle}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,10,10" Padding="12,8" Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" MinWidth="142">
                            <StackPanel>
                                <TextBlock Text="Last heartbeat" Foreground="{StaticResource MutedBrush}" FontSize="12" LineHeight="18"/>
                                <TextBlock x:Name="HeaderLastSeenText" Text="No heartbeat" Style="{StaticResource ValueTextStyle}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" x:Name="PageHost" Margin="24,20,22,18">
                <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Overview" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="A quick view of the Agent connection, Windows Service state, database access, and request audit."
                                   Style="{StaticResource PageSubtitleStyle}" Margin="0,0,0,18"/>

                        <WrapPanel>
                            <Border Style="{StaticResource MetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Connection" Foreground="{StaticResource MutedBrush}" LineHeight="22"/>
                                    <TextBlock x:Name="OverviewConnectionText" Text="Action required" Style="{StaticResource StatusTextStyle}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Windows Service" Foreground="{StaticResource MutedBrush}" LineHeight="22"/>
                                    <TextBlock x:Name="OverviewServiceText" Text="Not installed" Style="{StaticResource StatusTextStyle}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Database Access" Foreground="{StaticResource MutedBrush}" LineHeight="22"/>
                                    <TextBlock x:Name="OverviewDatabaseText" Text="Not checked" Style="{StaticResource StatusTextStyle}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Request Audit" Foreground="{StaticResource MutedBrush}" LineHeight="22"/>
                                    <TextBlock x:Name="OverviewAuditText" Text="Audit enabled" Style="{StaticResource StatusTextStyle}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <Grid x:Name="OverviewDetailsGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource SectionStyle}">
                                <StackPanel>
                                    <TextBlock Text="Configuration summary" Style="{StaticResource SectionTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Relay URL" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,10"/>
                                        <TextBlock x:Name="SummaryRelayText" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Margin="0,0,0,10"/>
                                        <TextBlock Text="Agent ID" Grid.Row="1" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,10"/>
                                        <TextBlock x:Name="SummaryAgentIdText" Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Margin="0,0,0,10"/>
                                        <TextBlock Text="Service account" Grid.Row="2" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,10"/>
                                        <TextBlock x:Name="SummaryServiceAccountText" Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Margin="0,0,0,10"/>
                                        <TextBlock Text="Poll interval" Grid.Row="3" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,10"/>
                                        <TextBlock x:Name="SummaryPollText" Grid.Row="3" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Margin="0,0,0,10"/>
                                        <TextBlock Text="Audit retention" Grid.Row="4" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBlock x:Name="SummaryAuditText" Grid.Row="4" Grid.Column="1" Style="{StaticResource ValueTextStyle}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border x:Name="OverviewQuickActionsPanel" Grid.Column="2" Style="{StaticResource SectionStyle}">
                                <StackPanel>
                                    <TextBlock Text="Quick actions" Style="{StaticResource SectionTitleStyle}"/>
                                    <WrapPanel>
                                        <Button Style="{StaticResource BaseButtonStyle}" Click="TestRelay_Click">Test relay</Button>
                                        <Button Style="{StaticResource BaseButtonStyle}" Click="RestartService_Click">Restart service</Button>
                                        <Button Style="{StaticResource BaseButtonStyle}" Click="OpenDatabasePage_Click">Check database</Button>
                                        <Button Style="{StaticResource BaseButtonStyle}" Click="OpenAuditPage_Click">Open audit</Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="ConnectionPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Connection" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="Set the Relay endpoint, Agent token, and polling cadence used by the Windows Service."
                                   Style="{StaticResource PageSubtitleStyle}" Margin="0,0,0,18"/>
                        <Border Style="{StaticResource SectionStyle}">
                            <StackPanel>
                                <TextBlock Text="Connection configuration" Style="{StaticResource SectionTitleStyle}"/>
                                <Grid x:Name="ConnectionFieldsGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock x:Name="RelayUrlLabel" Text="Relay URL" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,12"/>
                                    <TextBox x:Name="RelayUrlBox" Grid.Column="1" Margin="0,0,0,12"/>
                                    <Button x:Name="ReplaceRelayUrlButton" Grid.Column="2" Style="{StaticResource BaseButtonStyle}" Margin="8,0,0,12" Click="ReplaceRelayUrl_Click">Replace</Button>

                                    <TextBlock x:Name="AgentIdLabel" Text="Agent ID" Grid.Row="1" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,12"/>
                                    <TextBox x:Name="AgentIdBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12"/>

                                    <TextBlock x:Name="AgentTokenLabel" Text="Agent Token" Grid.Row="2" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,12"/>
                                    <PasswordBox x:Name="AgentTokenBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,12"/>
                                    <Button x:Name="ReplaceAgentTokenButton" Grid.Row="2" Grid.Column="2" Style="{StaticResource BaseButtonStyle}" Margin="8,0,0,12" Click="ReplaceToken_Click">Replace token</Button>

                                    <TextBlock x:Name="PollIntervalLabel" Text="Poll interval" Grid.Row="3" Style="{StaticResource FieldLabelStyle}"/>
                                    <StackPanel x:Name="PollIntervalPanel" Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox x:Name="PollSecondsBox" Width="86" Text="10" PreviewTextInput="NumericOnly_PreviewTextInput"/>
                                        <TextBlock Text="seconds" Style="{StaticResource FieldLabelStyle}" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Border x:Name="ConnectionNoticeBorder" Margin="160,18,0,0" Padding="12,10" Background="{StaticResource SurfaceAltBrush}" CornerRadius="6">
                                    <TextBlock x:Name="ConnectionNoticeText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="22"/>
                                </Border>

                                <WrapPanel x:Name="ConnectionActionsPanel" Margin="160,18,0,0">
                                    <Button Style="{StaticResource PrimaryButtonStyle}" Click="SaveConfiguration_Click">Save securely</Button>
                                    <Button Style="{StaticResource BaseButtonStyle}" Click="TestRelay_Click">Test relay</Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="ServicePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Windows Service" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="Install, update, and control the background Relay MCP Agent service."
                                   Style="{StaticResource PageSubtitleStyle}" Margin="0,0,0,18"/>
                        <Grid x:Name="ServiceLayoutGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource SectionStyle}">
                                <StackPanel>
                                    <TextBlock Text="Service information" Style="{StaticResource SectionTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Status" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,12"/>
                                        <TextBlock x:Name="ServiceStateText" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource StatusTextStyle}" Margin="0,0,0,12"/>
                                        <TextBlock Text="Run as" Grid.Row="1" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,12"/>
                                        <TextBlock x:Name="ServiceIdentityText" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource ValueTextStyle}" Margin="0,0,0,12"/>
                                        <TextBlock Text="Executable" Grid.Row="2" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBlock x:Name="ServicePathText" Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueTextStyle}" TextWrapping="NoWrap"/>
                                        <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource IconButtonStyle}" ToolTip="Copy executable path" Click="CopyServicePath_Click" Margin="8,0,0,0">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C8;" FontSize="14"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border x:Name="ServiceActionsPanel" Grid.Column="2" Style="{StaticResource SectionStyle}">
                                <StackPanel>
                                    <TextBlock Text="Service actions" Style="{StaticResource SectionTitleStyle}"/>
                                    <WrapPanel>
                                        <Button Style="{StaticResource PrimaryButtonStyle}" Click="InstallService_Click">Install or update</Button>
                                        <Button x:Name="StartServiceButton" Style="{StaticResource BaseButtonStyle}" Click="StartService_Click">Start</Button>
                                        <Button x:Name="StopServiceButton" Style="{StaticResource BaseButtonStyle}" Click="StopService_Click">Stop</Button>
                                        <Button x:Name="RestartServiceButton" Style="{StaticResource BaseButtonStyle}" Click="RestartService_Click">Restart</Button>
                                    </WrapPanel>
                                    <Border Margin="0,10,0,0" Padding="12" Background="{StaticResource DangerSoftBrush}" CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock Text="Danger zone" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" LineHeight="24"/>
                                            <TextBlock Text="Remove the Windows Service registration while keeping local configuration files."
                                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,2,0,10"/>
                                            <Button x:Name="UninstallServiceButton" Style="{StaticResource DangerButtonStyle}" Click="UninstallService_Click">Uninstall service</Button>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="DatabasePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Database Access" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="Discover SQL targets and verify the service account permissions used by MCP database tools."
                                   Style="{StaticResource PageSubtitleStyle}" Margin="0,0,0,18"/>
                        <Grid x:Name="DatabaseLayoutGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                                <Border x:Name="DatabaseTargetPanel" Style="{StaticResource SectionStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Target" Style="{StaticResource SectionTitleStyle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="SQL Server" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,12"/>
                                            <ComboBox x:Name="SqlServerBox" Grid.Column="1" IsEditable="True" Margin="0,0,0,12"/>
                                            <TextBlock Text="Database" Grid.Row="1" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,12"/>
                                            <ComboBox x:Name="DatabaseBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12"/>
                                            <TextBlock Text="Service identity" Grid.Row="2" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,12"/>
                                            <TextBlock x:Name="DatabaseIdentityText" Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Margin="0,0,0,12"/>
                                            <TextBlock Text="Result" Grid.Row="3" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock x:Name="DatabaseResultText" Grid.Row="3" Grid.Column="1" Text="Not checked" Style="{StaticResource StatusTextStyle}"/>
                                        </Grid>
                                        <WrapPanel Margin="150,18,0,0">
                                            <Button Style="{StaticResource PrimaryButtonStyle}" Click="DetectDatabases_Click">Detect databases</Button>
                                            <Button Style="{StaticResource BaseButtonStyle}" Click="TestDatabaseAccess_Click">Test current access</Button>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="DatabasePermissionPanel" Grid.Row="1" Style="{StaticResource SectionStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Permission evidence" Style="{StaticResource SectionTitleStyle}"/>
                                        <DataGrid x:Name="PermissionGrid" MinHeight="300" ItemsSource="{Binding PermissionRows}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Permission" Binding="{Binding Permission}" Width="1.4*" MinWidth="150"/>
                                                <DataGridTemplateColumn Header="Current" Width="1.2*" MinWidth="130">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{Binding StatusBackground}" CornerRadius="10" Padding="9,3" HorizontalAlignment="Left">
                                                                <TextBlock Text="{Binding Current}" Foreground="{Binding StatusForeground}" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="Read" Binding="{Binding Read}" Width="*" MinWidth="110"/>
                                                <DataGridTextColumn Header="Write" Binding="{Binding Write}" Width="*" MinWidth="110"/>
                                                <DataGridTextColumn Header="DDL" Binding="{Binding Ddl}" Width="*" MinWidth="110"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>

                            <Border x:Name="DatabaseActionsPanel" Grid.Column="2" Grid.RowSpan="2" Style="{StaticResource SectionStyle}">
                                <StackPanel>
                                    <TextBlock Text="Access actions" Style="{StaticResource SectionTitleStyle}"/>
                                    <WrapPanel>
                                        <Button Style="{StaticResource BaseButtonStyle}" Click="GrantRead_Click">Grant read access</Button>
                                        <Button Style="{StaticResource BaseButtonStyle}" Click="GrantReadWrite_Click">Grant read/write access</Button>
                                    </WrapPanel>
                                    <Border Margin="0,12,0,0" Padding="12" Background="{StaticResource DangerSoftBrush}" CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock Text="High-risk access" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" LineHeight="24"/>
                                            <TextBlock Text="DDL and revoke operations change the service account's database rights."
                                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,2,0,10"/>
                                            <WrapPanel>
                                                <Button Style="{StaticResource DangerButtonStyle}" Click="GrantDdl_Click">Grant DDL access</Button>
                                                <Button Style="{StaticResource DangerButtonStyle}" Click="RevokeDatabaseAccess_Click">Revoke database access</Button>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="AuditPage"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="AuditPageGrid" MinHeight="650">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="150"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="0.72*" MinHeight="180"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Request Audit" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="Inspect the local Agent request log, filter by method and status, and export redacted evidence."
                                   Style="{StaticResource PageSubtitleStyle}" Margin="0,0,0,18"/>
                    </StackPanel>
                    <Border Grid.Row="1" Style="{StaticResource SectionStyle}" Padding="16">
                        <Grid x:Name="AuditToolbarGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <WrapPanel x:Name="AuditSettingsPanel" VerticalAlignment="Center">
                                <CheckBox x:Name="AuditEnabledCheck" Content="Audit enabled" Margin="0,0,18,8"/>
                                <CheckBox x:Name="AuditPayloadsCheck" Content="Log redacted payloads" Margin="0,0,18,8"/>
                                <TextBlock Text="Retention" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,8"/>
                                <TextBox x:Name="AuditRetentionBox" Width="70" Text="14" PreviewTextInput="NumericOnly_PreviewTextInput" Margin="0,0,18,8"/>
                            </WrapPanel>
                            <WrapPanel x:Name="AuditFilterActionsPanel" Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="Method" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,8"/>
                                <ComboBox x:Name="AuditMethodFilter" Width="98" SelectionChanged="AuditFilter_SelectionChanged" Margin="0,0,12,8">
                                    <ComboBoxItem Content="All"/><ComboBoxItem Content="GET"/><ComboBoxItem Content="POST"/>
                                </ComboBox>
                                <TextBlock Text="Status" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,8"/>
                                <ComboBox x:Name="AuditStatusFilter" Width="112" SelectionChanged="AuditFilter_SelectionChanged" Margin="0,0,12,8">
                                    <ComboBoxItem Content="All"/><ComboBoxItem Content="2xx"/><ComboBoxItem Content="4xx"/><ComboBoxItem Content="5xx"/>
                                </ComboBox>
                                <Button Style="{StaticResource PrimaryButtonStyle}" Click="ApplyAuditSettings_Click">Apply</Button>
                                <Button Style="{StaticResource BaseButtonStyle}" Click="ExportAudit_Click">Export</Button>
                                <Button Style="{StaticResource DangerButtonStyle}" Click="ClearAudit_Click">Clear</Button>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource SectionStyle}" Padding="12">
                        <Grid>
                            <DataGrid x:Name="AuditGrid" ItemsSource="{Binding AuditRows}" SelectionChanged="AuditGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="150" MinWidth="140"/>
                                    <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="86" MinWidth="80"/>
                                    <DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint}" Width="3*" MinWidth="260"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="94" MinWidth="86"/>
                                    <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="110" MinWidth="100"/>
                                    <DataGridTextColumn Header="Job ID" Binding="{Binding JobId}" Width="2*" MinWidth="220"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="AuditEmptyText" Text="No audited requests yet."
                                       Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Row="3"
                                  Height="10"
                                  HorizontalAlignment="Stretch"
                                  Background="Transparent"/>

                    <Border Grid.Row="4" Style="{StaticResource SectionStyle}" Padding="16" Margin="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Selected request" Style="{StaticResource SectionTitleStyle}"/>
                            <controls:TerminalTextBox x:Name="AuditDetailBox" Grid.Row="1"
                                                      Text="Select a request to inspect details."
                                                      MinHeight="170"/>
                        </Grid>
                    </Border>
                </Grid>
                </ScrollViewer>

                <Grid x:Name="PlaywrightPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid x:Name="PlaywrightHeaderGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Playwright" Style="{StaticResource PageTitleStyle}"/>
                            <TextBlock Text="Manage browser automation runtime, IIS Web Client discovery, suites, runs, and artifacts on the Agent host."
                                       Style="{StaticResource PageSubtitleStyle}" Margin="0,0,0,18"/>
                        </StackPanel>
                        <WrapPanel x:Name="PlaywrightHeaderActions" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Style="{StaticResource BaseButtonStyle}" Click="RefreshPlaywright_Click">Check runtime</Button>
                            <Button x:Name="PlaywrightInstallButton" Style="{StaticResource PrimaryButtonStyle}" Click="QueuePlaywrightInstall_Click">Install dependencies</Button>
                        </WrapPanel>
                    </Grid>

                    <TabControl Grid.Row="1"
                                x:Name="PlaywrightTabs"
                                Style="{StaticResource PlaywrightTabControlStyle}"
                                ItemContainerStyle="{StaticResource PlaywrightTabItemStyle}">
                        <TabItem Header="Overview">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,16,0,0">
                                    <WrapPanel>
                                        <Border Style="{StaticResource MetricCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Runtime" Foreground="{StaticResource MutedBrush}" LineHeight="22"/>
                                                <TextBlock x:Name="PlaywrightOverviewRuntimeText" Text="Not checked" Style="{StaticResource StatusTextStyle}" Margin="0,10,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource MetricCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Last run" Foreground="{StaticResource MutedBrush}" LineHeight="22"/>
                                                <TextBlock x:Name="PlaywrightOverviewLastRunText" Text="No runs yet" Style="{StaticResource ValueTextStyle}" FontSize="18" FontWeight="SemiBold" Margin="0,13,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource MetricCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Artifacts" Foreground="{StaticResource MutedBrush}" LineHeight="22"/>
                                                <TextBlock x:Name="PlaywrightOverviewArtifactsText" Text="0 files" Style="{StaticResource ValueTextStyle}" FontSize="18" FontWeight="SemiBold" Margin="0,13,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>
                                    <Border Style="{StaticResource SectionStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Runtime evidence" Style="{StaticResource SectionTitleStyle}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="130"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Node.js" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,12"/>
                                                <TextBlock x:Name="PlaywrightOverviewNodeText" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Margin="0,0,0,12"/>
                                                <TextBlock x:Name="PlaywrightOverviewNodeStatusText" Grid.Column="2" Style="{StaticResource StatusTextStyle}" Margin="0,0,0,12"/>
                                                <TextBlock Text="Playwright" Grid.Row="1" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,12"/>
                                                <TextBlock x:Name="PlaywrightOverviewPackageText" Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Margin="0,0,0,12"/>
                                                <TextBlock x:Name="PlaywrightOverviewPackageStatusText" Grid.Row="1" Grid.Column="2" Style="{StaticResource StatusTextStyle}" Margin="0,0,0,12"/>
                                                <TextBlock Text="Chromium" Grid.Row="2" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,12"/>
                                                <TextBlock x:Name="PlaywrightOverviewBrowserText" Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Margin="0,0,0,12"/>
                                                <TextBlock x:Name="PlaywrightOverviewBrowserStatusText" Grid.Row="2" Grid.Column="2" Style="{StaticResource StatusTextStyle}" Margin="0,0,0,12"/>
                                                <TextBlock Text="Service account" Grid.Row="3" Style="{StaticResource FieldLabelStyle}"/>
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="NT AUTHORITY\SYSTEM" Style="{StaticResource ValueTextStyle}"/>
                                                <TextBlock Grid.Row="3" Grid.Column="2" Text="Background execution" Foreground="{StaticResource MutedBrush}" Style="{StaticResource ValueTextStyle}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Runtime">
                            <ScrollViewer x:Name="PlaywrightRuntimeScroller"
                                          VerticalScrollBarVisibility="Disabled"
                                          HorizontalScrollBarVisibility="Disabled">
                            <Grid x:Name="PlaywrightRuntimePageGrid" Margin="0,16,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Style="{StaticResource SectionStyle}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="Dependencies" Style="{StaticResource SectionTitleStyle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Node.js" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,12"/>
                                            <TextBlock x:Name="PlaywrightNodeText" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Margin="0,0,0,12"/>
                                            <TextBlock x:Name="PlaywrightNodeStatusText" Grid.Column="2" Style="{StaticResource StatusTextStyle}" Margin="0,0,0,12"/>
                                            <TextBlock Text="npm" Grid.Row="1" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,12"/>
                                            <TextBlock x:Name="PlaywrightNpmText" Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Margin="0,0,0,12"/>
                                            <TextBlock x:Name="PlaywrightNpmStatusText" Grid.Row="1" Grid.Column="2" Style="{StaticResource StatusTextStyle}" Margin="0,0,0,12"/>
                                            <TextBlock Text="Playwright package" Grid.Row="2" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,12"/>
                                            <TextBlock x:Name="PlaywrightPackageText" Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Margin="0,0,0,12"/>
                                            <TextBlock x:Name="PlaywrightPackageStatusText" Grid.Row="2" Grid.Column="2" Style="{StaticResource StatusTextStyle}" Margin="0,0,0,12"/>
                                            <TextBlock Text="Chromium" Grid.Row="3" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,12"/>
                                            <TextBlock x:Name="PlaywrightChromiumText" Grid.Row="3" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Margin="0,0,0,12"/>
                                            <TextBlock x:Name="PlaywrightChromiumStatusText" Grid.Row="3" Grid.Column="2" Style="{StaticResource StatusTextStyle}" Margin="0,0,0,12"/>
                                            <TextBlock Text="Browser cache" Grid.Row="4" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBlock x:Name="PlaywrightCacheText" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource ValueTextStyle}" TextWrapping="Wrap"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Grid x:Name="PlaywrightRuntimeLayoutGrid" Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="300"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Style="{StaticResource SectionStyle}" Margin="0">
