{
  "name": "remote-ops-platform",
  "version": "0.6.3",
  "description": "MCP-based remote operations platform with web management UI",
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:mcp": "tsx watch src/mcp/index.ts",
    "check:mcp-boundary": "node scripts/check-mcp-boundary.mjs",
    "generate:mcp-baseline": "node --import tsx/esm scripts/generate-mcp-tools-baseline.mjs",
    "benchmark:knowledge-fts": "tsx scripts/knowledge-fts-benchmark.ts",
    "test": "npm run check:mcp-boundary && tsx --test tests/*.test.ts",
    "relay-upload": "node scripts/relay-upload.mjs",
    "relay-download": "node scripts/relay-download.mjs",
    "build": "npm run check:mcp-boundary && tsc && npm --prefix frontend run build",
    "start:server": "node dist/server/index.js",
    "start:mcp": "node dist/mcp/index.js",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.0",
    "@fastify/jwt": "^8.0.0",
    "@fastify/static": "^7.0.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.11.1",
    "diff": "^5.2.0",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.30.0",
    "express": "^4.19.0",
    "fastify": "^4.28.0",
    "fflate": "^0.8.3",
    "jsonwebtoken": "^9.0.0",
    "node-ssh": "^13.2.0",
    "yaml": "^2.4.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.8",
    "@types/diff": "^5.2.1",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.0.0",
    "drizzle-kit": "^0.20.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
