+// ModelResponseError prevents a provider from echoing prompt/credential data
+// into task errors, spans or logs while preserving the failure boundary.
+type ModelResponseFailure struct {
+	Body string
+	Stream bool
+}
+
+func (e *ModelResponseFailure) Error() string {
+	return fmt.Sprintf("model response error (body omitted; stream=%t)", e.Stream)
+}
+
+func ModelResponseError(message string, stream bool) error {
+	return &ModelResponseFailure{Body: message, Stream: stream}
+}
