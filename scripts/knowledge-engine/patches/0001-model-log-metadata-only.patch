+// LogRequest records only fixed fields and numeric statistics in the Relay
+// managed build. URL, model, prompts and responses can contain private values.
+func LogRequest(ctx context.Context, _, _ string, body []byte, stream bool) {
+	var envelope struct {
+		Messages []json.RawMessage `json:"messages"`
+	}
+	_ = json.Unmarshal(body, &envelope)
+	logger.Infof(ctx, "[LLM Request] stream=%v, body_bytes=%d, message_count=%d, body_logged=false",
+		stream, len(body), len(envelope.Messages))
+}
