+// wikiSummaryRawEvidence records only raw text chunks actually supplied to the
+// summary request. The final chunk may contribute a prefix at the rune budget;
+// chunks beyond that prefix and generated image children are not cited.
+func wikiSummaryRawEvidence(chunks []*types.Chunk, tenantID uint64, knowledgeID string, maxRunes int) (string, []string) {
+	var selected []*types.Chunk
+	for _, c := range chunks {
+		if c != nil && c.ID != "" && c.TenantID == tenantID && c.KnowledgeID == knowledgeID && c.IsEnabled &&
+			(c.ChunkType == types.ChunkTypeText || c.ChunkType == "") && strings.TrimSpace(c.Content) != "" {
+			selected = append(selected, c)
+		}
+	}
+	sort.SliceStable(selected, func(i, j int) bool {
+		if selected[i].ChunkIndex != selected[j].ChunkIndex {
+			return selected[i].ChunkIndex < selected[j].ChunkIndex
+		}
+		return selected[i].StartAt < selected[j].StartAt
+	})
+	var body strings.Builder
+	var ids []string
+	seen := map[string]bool{}
+	remaining := maxRunes
+	for _, c := range selected {
+		if remaining <= 0 {
+			break
+		}
+		if seen[c.ID] {
+			continue
+		}
+		separator := ""
+		if body.Len() > 0 {
+			separator = "\n\n"
+		}
+		if remaining <= len(separator) {
+			break
+		}
+		remaining -= len(separator)
+		raw := []rune(c.Content)
+		if len(raw) > remaining {
+			raw = raw[:remaining]
+		}
+		body.WriteString(separator)
+		body.WriteString(string(raw))
+		remaining -= len(raw)
+		ids = append(ids, c.ID)
+		seen[c.ID] = true
+	}
+	return body.String(), ids
+}
