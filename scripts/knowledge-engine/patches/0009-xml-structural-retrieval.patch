+
+// Recognize explicit element syntax, including quoted attributes. A comparison
+// such as a < b > c and malformed/unquoted attributes do not declare an element.
+const xmlQueryName = `[\p{L}_][\p{L}\p{N}\p{M}_.:\-]*`
+
+var xmlQueryTag = regexp.MustCompile(`</?(` + xmlQueryName + `)(?:[ \t\r\n]+` + xmlQueryName + `[ \t\r\n]*=[ \t\r\n]*(?:"[^"<]*"|'[^'<]*'))*[ \t\r\n]*/?>`)
+
+// keywordXMLStructuralPreference preserves the intent of explicit XML element
+// queries without narrowing the broad lexical fallback. Multiple elements are
+// a conjunction within a candidate chunk. SQL values are always bound; names,
+// namespaces and case are preserved. GLOB's name boundary prevents NodeExtra
+// from matching Node. No index migration or source rewriting is needed.
+func keywordXMLStructuralPreference(query string) (string, []interface{}) {
+	var clauses []string
+	var args []interface{}
+	seen := make(map[string]bool)
+	for _, match := range xmlQueryTag.FindAllStringSubmatch(query, -1) {
+		name := match[1]
+		if strings.HasPrefix(match[0], "</") && strings.TrimSpace(strings.TrimPrefix(match[0], "</"+name)) != ">" {
+			continue
+		}
+		if seen[name] {
+			continue
+		}
+		seen[name] = true
+		// Keep preference evaluation bounded for adversarially long queries. When
+		// the bound is exceeded, preserve the ordinary lexical search in full.
+		if len(seen) > 32 {
+			return "0", nil
+		}
+		clauses = append(clauses, "(e.content GLOB ? OR e.content GLOB ?)")
+		args = append(args, "*<"+name+"[ \t\r\n/>]*", "*</"+name+"[ \t\r\n>]*")
+	}
+	if len(clauses) == 0 {
+		return "0", nil
+	}
+	return "CASE WHEN " + strings.Join(clauses, " AND ") + " THEN 1 ELSE 0 END", args
+}
