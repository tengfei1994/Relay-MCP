+var xmlNamedAngleReplacer = strings.NewReplacer("&lt;", "<", "&gt;", ">", "&LT;", "<", "&GT;", ">")
+
+func keywordXMLHeadingMatch(query, content string) bool {
+	names := make(map[string]bool)
+	for _, match := range xmlQueryTag.FindAllStringSubmatch(query, -1) {
+		name := match[1]
+		if strings.HasPrefix(match[0], "</") && strings.TrimSpace(strings.TrimPrefix(match[0], "</"+name)) != ">" {
+			continue
+		}
+		names[name] = true
+		if len(names) > 32 {
+			return false
+		}
+	}
+	if len(names) == 0 {
+		return false
+	}
+	fence := ""
+	for _, line := range strings.Split(xmlNamedAngleReplacer.Replace(content), "\n") {
+		trimmed := strings.TrimSpace(line)
+		marker := ""
+		if strings.HasPrefix(trimmed, "```") || strings.HasPrefix(trimmed, "~~~") {
+			marker = trimmed[:3]
+		}
+		if marker != "" {
+			if fence == "" {
+				fence = marker
+			} else if strings.HasPrefix(trimmed, fence) && strings.TrimSpace(trimmed[len(fence):]) == "" {
+				fence = ""
+			}
+			continue
+		}
+		if fence != "" {
+			continue
+		}
+		heading := strings.TrimLeft(line, " \t")
+		level := 0
+		for level < len(heading) && heading[level] == '#' {
+			level++
+		}
+		if level == 0 || level > 6 || len(heading) == level || (heading[level] != ' ' && heading[level] != '\t') {
+			continue
+		}
+		for name := range names {
+			if !xmlHeadingHasElement(heading[level:], name) {
+				goto nextLine
+			}
+		}
+		return true
+	nextLine:
+	}
+	return false
+}
+
+func xmlHeadingHasElement(line, name string) bool {
+	for _, prefix := range []string{"<" + name, "</" + name} {
+		for offset := 0; offset < len(line); {
+			index := strings.Index(line[offset:], prefix)
+			if index < 0 {
+				break
+			}
+			end := offset + index + len(prefix)
+			if end < len(line) && strings.ContainsRune(" \t\r\n/>", rune(line[end])) {
+				return true
+			}
+			offset = end
+		}
+	}
+	return false
+}
